# =============================================================================
# AssureCode — Environment Variables
# Copy to .env and fill in real values for local development.
# =============================================================================

# ── PostgreSQL + pgvector ──────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=assurecode
POSTGRES_PASSWORD=assurecode_local_dev
POSTGRES_DB=assurecode
DATABASE_URL=postgresql://assurecode:assurecode_local_dev@localhost:5432/assurecode

# ── Neo4j ──────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=assurecode_local_dev
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ── Redis ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── LocalStack (S3) ────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_ENDPOINT=http://localhost:4566
S3_BUCKET_NAME=assurecode-artifacts
LOCALSTACK_PORT=4566

# ── Razorpay (test mode) ───────────────────────────────────────
# Dashboard → Settings → API Keys. The key id is public (it ships to the
# browser so Checkout can open); the key secret must not leave the server.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# A separate value, set under Settings → Webhooks. It signs webhook bodies and
# is not interchangeable with the key secret above.
RAZORPAY_WEBHOOK_SECRET=whsec_...
# Razorpay cannot reach localhost — use ngrok to expose the gateway's
# /webhooks/razorpay if you want live webhook delivery. The
# POST /api/contracts/:id/escrow/verify route confirms funding without it.

# Where the browser reaches the web app; used for KYC / payout return URLs.
WEB_APP_URL=http://localhost:3000

# ── GitHub Webhooks ────────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=whsec_...
# Use ngrok to expose local webhook-ingest:9000 to GitHub
# NGROK_URL=https://xxxx.ngrok-free.app

# ── LLM — Cloudflare Workers AI ────────────────────────────────
# The only provider. Drives test generation, the security scan's LLM layer and
# the XAI judge. Set LLM_PROVIDER=fake to run those offline against a
# deterministic fixture; any other value is rejected at startup.
LLM_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# ── App Ports ──────────────────────────────────────────────────
GATEWAY_PORT=4000
WEBHOOK_INGEST_PORT=9000
AI_SERVICE_PORT=8000
SCOPE_GUARD_PORT=8001

# ── Node Environment ───────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Ledger signing (Phase 8) ──────────────────────────────────────────
# FIPS 204 ML-DSA-87 seed for signing Merkle roots. 32 bytes, hex-encoded.
# Generate with:  python -c "import os;print(os.urandom(32).hex())"
# The signer refuses to run without one rather than mint a throwaway key,
# because a signature under a key nobody else holds proves nothing.
# Development posture only — production keeps the private key in an HSM/KMS
# and distributes only the public key (tools/sign_merkle_root.py --show-public-key).
ML_DSA_SEED_HEX=

# ── Event bus ──────────────────────────────────────────────────
# memory | redis | kafka. Unset defaults to redis. Kafka additionally needs the
# overlay in infra/docker-compose.kafka.yml to be running.
EVENT_BUS_TYPE=redis
KAFKA_BROKERS=localhost:9092

# ── CORS ───────────────────────────────────────────────────────
# Comma-separated allow-list read by api-gateway. Unset in development the
# gateway reflects the Origin header; unset in production it falls back to a
# single hardcoded hostname, so set this explicitly for any real deployment.
ALLOWED_ORIGINS=http://localhost:3000

# ── Observability ──────────────────────────────────────────────
# Where packages/telemetry ships OTLP spans. Nothing listens on this address
# until the collector is running — `npm run infra:up` starts one alongside
# Jaeger, Prometheus and Grafana (infra/docker-compose.yml).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── CI sandbox ─────────────────────────────────────────────────
# docker | node. `docker` gives real container isolation and needs the Docker
# socket available to ci-worker; `node` uses the Node permission model, which
# is weaker and is what the Kubernetes manifests pin.
SANDBOX_RUNNER=docker

# ── Rate limiting ──────────────────────────────────────────────
# Global bucket applies to every route except /healthz, /readyz and /metrics.
# The login bucket is separate and tighter: /auth/login is unauthenticated and
# performs argon2id verification, so it is both the brute-force target and the
# cheapest way to burn gateway CPU. Limits are disabled under NODE_ENV=test.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_LOGIN_MAX=10

# ── Scope-guard drift calibration ──────────────────────────────
# Path to the T2 residual set used to select the CUSUM kappa/h parameters.
# configs/c1_rules.json ships with both null and status PRE_DATA, so /drift/status
# returns 503 until a real calibration set exists. The synthetic file below is
# for local wiring checks ONLY — it is random floats, not measured residuals,
# and no false-alarm rate derived from it may be reported.
SCOPE_DRIFT_CALIBRATION_PATH=
SCOPE_DRIFT_CALIBRATION_SYNTHETIC=0

# ── Real GitHub push auditing ──────────────────────────────────
# A GitHub push webhook carries repository coordinates but no file contents, so
# with this off, webhook-originated pushes are refused (with an explanation)
# and only the gateway's /simulate-push — which carries code inline — reaches
# the verification pipeline. Turning it on makes ci-worker fetch the commit's
# source from the GitHub API, pinned to the exact SHA the webhook reported.
ENABLE_GITHUB_SOURCE_FETCH=false
# Required for private repos. Public repos work without it at 60 requests/hour
# per IP, and one audit costs one request per source file plus one for the tree.
GITHUB_TOKEN=

# ── Matchmaking graph backend ──────────────────────────────────
# postgres (default) | neo4j
#
# postgres uses pgvector + an HNSW index and is what tools/seed-users.py
# populates. neo4j uses Neo4j's native vector index and additionally requires:
#   npm run seed:neo4j                  # graph structure
#   python tools/seed-neo4j-vectors.py  # embeddings + index
# Without that index the Neo4j adapter degrades to an in-process fixture, so the
# service looks healthy while ranking against hardcoded data.
#
# Both backends are verified to produce identical rankings — see the parity test
# in apps/ai-service/tests/test_graph_repo_neo4j.py.
GRAPH_BACKEND=postgres
