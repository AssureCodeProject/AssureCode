# ── Dependencies ───────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version

# ── Build output ───────────────────────────────────────────────
dist/
build/
out/

# Emitted JS must never sit beside its .ts source. packages/telemetry had no
# outDir and emitted in place, and those stale files then shadowed the real
# TypeScript at runtime (vitest and node both resolved the .js first). The
# tsconfigs now all emit to dist/; these patterns stop a regression from being
# committed again.
apps/*/src/**/*.js
apps/*/src/**/*.d.ts
apps/*/src/**/*.js.map
!apps/web/src/**/*.js
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
.next/
.nuxt/
*.tsbuildinfo
.vite/
.turbo/

# ── Logs ───────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Environment & secrets ──────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
*.env
!.env.example

# Locally-filled Kubernetes Secret overrides. The tracked base manifest holds
# only REPLACE_ME placeholders; real values go in a .local.yaml applied on top
# (see infra/k8s/overlays/local/01-secrets.example.yaml).
infra/k8s/**/*.local.yaml

# ── Editor / OS ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Test / coverage ────────────────────────────────────────────
coverage/
.nyc_output/
.pytest_cache/
.coverage
coverage/
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ── Docker / infra ─────────────────────────────────────────────
docker-compose.override.yml
*.pid
.data/
data/
# Container data directories, not source. The bare `neo4j/` pattern also
# matched infra/seed/neo4j/, so the matchmaking seed was never committed and
# `npm run seed:neo4j` found nothing on a fresh clone — the negation below
# keeps the runtime volume ignored while tracking the seed.
neo4j/
!infra/seed/neo4j/
postgres-data/

# ── Local run artifacts ────────────────────────────────────────
# S3-fallback output written when LocalStack is unavailable. These are the
# results of somebody's local run, not source; a set of them was committed by
# accident, including one LLM response with prompt instructions leaked into it.
storage_fallback/
apps/ai-service/storage_fallback/
# Agent scratch directories (BRIEFING/DISPATCH/handoff/progress). Process
# residue from how the code was produced, not part of the artifact.
.agents/

# ── Misc ───────────────────────────────────────────────────────
.cache/
*.local
playwright-report/
test-results/
