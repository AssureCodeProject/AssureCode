# ── Dependencies ───────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version

# ── Build output ───────────────────────────────────────────────
dist/
build/
out/

# Emitted JS must never sit beside its .ts source. packages/telemetry had no
# outDir and emitted in place, and those stale files then shadowed the real
# TypeScript at runtime (vitest and node both resolved the .js first). The
# tsconfigs now all emit to dist/; these patterns stop a regression from being
# committed again.
apps/*/src/**/*.js
apps/*/src/**/*.d.ts
apps/*/src/**/*.js.map
!apps/web/src/**/*.js
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
.next/
.nuxt/
*.tsbuildinfo
.vite/
.turbo/

# ── Logs ───────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Environment & secrets ──────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
*.env
!.env.example

# ── Editor / OS ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Test / coverage ────────────────────────────────────────────
coverage/
.nyc_output/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ── Docker / infra ─────────────────────────────────────────────
docker-compose.override.yml
*.pid
.data/
data/
neo4j/
postgres-data/

# ── Misc ───────────────────────────────────────────────────────
.cache/
*.local
playwright-report/
test-results/
