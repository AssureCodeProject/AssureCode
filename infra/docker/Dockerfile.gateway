# =============================================================================
# Production Dockerfile — API Gateway (Node.js / Fastify)
# =============================================================================

FROM node:20-alpine AS builder
WORKDIR /app

# Copy root & workspace package configs
COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY packages/config/package*.json ./packages/config/
COPY packages/telemetry/package*.json ./packages/telemetry/
COPY packages/razorpay-adapter/package*.json ./packages/razorpay-adapter/
COPY packages/kyc-adapter/package*.json ./packages/kyc-adapter/
COPY packages/event-bus/package*.json ./packages/event-bus/
COPY packages/ledger-client/package*.json ./packages/ledger-client/
COPY apps/api-gateway/package*.json ./apps/api-gateway/

RUN npm ci

# Copy source files
COPY packages/ ./packages/
COPY apps/api-gateway/ ./apps/api-gateway/
COPY tsconfig.base.json ./
# `npm run build` runs scripts/build-workspaces.mjs. This COPY was missing, so
# the build died with MODULE_NOT_FOUND on its own build script and this image
# had never been produced successfully.
COPY scripts/ ./scripts/

# Build packages and API gateway. The script skips workspaces absent from the
# image (ci-worker, settlement-worker, webhook-ingest are not copied here).
RUN npm run build

# Missing on this Dockerfile until now — every other service image here prunes
# before shipping (see Dockerfile.settlement-worker). Without it, the full
# devDependency tree (vitest included) rode into the runner stage's
# node_modules copy below, which is how a test framework — CVE-2026-47429,
# arbitrary code execution — ended up shipping in a production image.
RUN npm prune --omit=dev

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# node:20-alpine ships npm's own bundled tar at 6.2.1 (CVE-2026-59873, a
# gzip-bomb DoS fixed at 7.5.19) — nothing to do with this service's own
# dependencies. See the matching comment in Dockerfile.ci-worker for why
# npm@11 specifically (the newest line that still installs on Node 20).
RUN npm install -g npm@11

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/api-gateway ./apps/api-gateway

EXPOSE 4000
CMD ["node", "apps/api-gateway/dist/server.js"]
