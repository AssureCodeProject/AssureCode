# =============================================================================
# Production Dockerfile — Webhook Ingest (Node.js / Fastify)
#
# GitHub's HMAC-signed push events land here. The service refuses to start in
# production without GITHUB_WEBHOOK_SECRET (see src/server.ts), so this image
# will exit 1 rather than come up accepting forged events.
# =============================================================================

FROM node:20-alpine AS builder
WORKDIR /app

# Workspace manifests first, so `npm ci` caches independently of source edits.
COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY packages/config/package*.json ./packages/config/
COPY packages/telemetry/package*.json ./packages/telemetry/
COPY packages/event-bus/package*.json ./packages/event-bus/
COPY apps/webhook-ingest/package*.json ./apps/webhook-ingest/

RUN npm ci

COPY packages/ ./packages/
COPY apps/webhook-ingest/ ./apps/webhook-ingest/
COPY tsconfig.base.json ./
COPY scripts/ ./scripts/

# Explicit workspace list — see the same block in Dockerfile.ci-worker. A bare
# `npm run build` here walks the full ORDER in scripts/build-workspaces.mjs and
# compiles workspaces whose manifests this image never installs.
RUN node scripts/build-workspaces.mjs \
      packages/shared \
      packages/telemetry \
      packages/config \
      packages/event-bus \
      apps/webhook-ingest

# Drop dev dependencies from the tree that gets copied forward. Without this
# the runner ships typescript, tsx and vitest — build tooling with no business
# being in a production image, and more surface for a scanner to flag.
RUN npm prune --omit=dev

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# node:20-alpine ships npm's own bundled tar at 6.2.1 (CVE-2026-59873, a
# gzip-bomb DoS fixed at 7.5.19) — nothing to do with this service's own
# dependencies. See the matching comment in Dockerfile.ci-worker for why
# npm@11 specifically (the newest line that still installs on Node 20).
RUN npm install -g npm@11

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/webhook-ingest ./apps/webhook-ingest

# node:alpine ships an unprivileged `node` user (uid 1000). Running as root
# inside the container buys nothing here and costs containment if the process
# is ever compromised.
USER node

EXPOSE 9000
CMD ["node", "apps/webhook-ingest/dist/server.js"]
